# Template file for 'dracut-bcachefs'
pkgname=dracut-bcachefs
version=0.1.0
revision=3
depends="dracut bcachefs-tools"
short_desc="dracut integration module for bcachefs root filesystem"
maintainer="KennedySilverDollar <kenshinlights@tutamail.com>"
license="GPL-2.0-or-later"
homepage="https://github.com/KennedySilverDollar/dracut-bcachefs"
# Not intended for upstream submission (void-packages/dracut/
# bcachefs-tools) -- independent package, built locally only.
# No build_style and no distfiles: xbps-src runs only do_install().
# The module files come from files/70bcachefs/ in the srcpkgs dir
# (populated by scripts/sync-to-void-packages.sh).

do_install(){
vmkdir usr/lib/dracut/modules.d/70bcachefs
vcopy "${FILESDIR}/70bcachefs/module-setup.sh" \
usr/lib/dracut/modules.d/70bcachefs/module-setup.sh
vcopy "${FILESDIR}/70bcachefs/bcachefs_timeout.sh" \
usr/lib/dracut/modules.d/70bcachefs/bcachefs_timeout.sh
chmod +x "${DESTDIR}/usr/lib/dracut/modules.d/70bcachefs/"*.sh
}